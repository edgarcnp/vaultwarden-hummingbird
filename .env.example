# One config file, three ways to use it:
# 1. Supervisor-owned (compose default): copy to .env, mount it, set
#    SUPERVISOR_ENV_FILE. SUPERVISOR_*/TAILSCALE_* stay with PID 1;
#    VAULTWARDEN_* reach vaultwarden under the stripped plain upstream
#    name; bare upstream names are forwarded verbatim.
# 2. Container env: --env-file .env / env_file: .env
# 3. PaaS dashboard
#
# Precedence: process env > file for SUPERVISOR_*/TAILSCALE_* and the
# exposed port (VAULTWARDEN_PORT > VAULTWARDEN_ROCKET_PORT > 8080; only
# /alive is answered there — the supervisor's gatekeeper, vaultwarden
# itself binds loopback one port above it); file > image-baked defaults
# for the rest (ROCKET_PORT/ROCKET_ADDRESS/DATA_FOLDER are hard-pinned by
# the supervisor). Empty values = unset.
#
# Namespaces: SUPERVISOR_* configures supervisor-initiated features (S3
# sync, DB backup, keepalive); TAILSCALE_* configures the Tailscale
# subsystem; VAULTWARDEN_* configures vaultwarden (prefix stripped in
# supervisor mode). Full list of upstream keys: vaultwarden's .env.template.
# Values containing '#' must be quoted. Copy to .env, replace the
# placeholders (the required keys are uncommented below), keep out of git.

# ============================================================================
# SUPERVISOR_DB_BACKUP* — DB backup to S3 (optional; needs the S3 keys below)
#   Consumed by the supervisor (PID 1); never forwarded to vaultwarden.
#   Periodic consistent dumps of the vault DB pushed to
#   <SUPERVISOR_S3_REMOTE>/db:
#     postgres -> pg_dump custom format    mysql -> mariadb-dump SQL    sqlite -> VACUUM INTO
#   Snapshots are consistent while the vault runs; keep-N prunes the oldest
#   per backend after each push. Same single-container-per-bucket caveat as
#   the state sync; dump objects contain vault metadata — keep the bucket
#   private.
# ============================================================================

# Enable periodic dumps.
#SUPERVISOR_DB_BACKUP=true
# Seconds between dumps (default 12h).
#SUPERVISOR_DB_BACKUP_INTERVAL=43200
# Dumps kept per backend.
#SUPERVISOR_DB_BACKUP_KEEP=3
# Boot-time restore: if the DB is verifiably EMPTY, import the newest dump.
# Ambiguity (DB unreachable) fails closed — never overwrites existing data.
#SUPERVISOR_DB_BACKUP_RESTORE=false
# Manual restore reference:
#   postgres: pg_restore --no-owner --no-privileges --dbname=<db> <dump>
#   mysql:    mariadb --database=<db> --execute="source <dump>"
#   sqlite:   stop the vault, replace /data/db.sqlite3 with the dump file

# ============================================================================
# SUPERVISOR_DB_KEEPALIVE — DB keepalive ping (optional)
#   Consumed by the supervisor (PID 1); never forwarded to vaultwarden.
#   Periodic `SELECT 1` so providers that suspend idle databases stay awake.
#   Seconds; 0 or unset = off. Requires VAULTWARDEN_DATABASE_URL (postgres).
# ============================================================================

#SUPERVISOR_DB_KEEPALIVE=300

# ============================================================================
# SUPERVISOR_S3_* — S3 state sync (optional)
#   Consumed by the supervisor (PID 1); never forwarded to vaultwarden.
#   Pulls /data identity files at boot and pushes them on a cadence so the
#   tailnet node survives ephemeral redeploys.
# ============================================================================

# rclone destination remote:path for the /data identity files.
#SUPERVISOR_S3_REMOTE=r2:vw-state
#SUPERVISOR_S3_ACCESS_KEY_ID=
#SUPERVISOR_S3_SECRET_ACCESS_KEY=
# Custom S3 endpoint (e.g. Cloudflare R2); empty = AWS default.
#SUPERVISOR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Seconds between periodic pushes.
#SUPERVISOR_S3_SYNC_INTERVAL=3600

# ============================================================================
# TAILSCALE_* — Tailscale subsystem (REQUIRED)
#   Consumed by the supervisor (PID 1); never forwarded to vaultwarden.
#   Boot fails closed without it, and any Tailscale boot failure exits 1.
# ============================================================================

# Tailscale auth key or OAuth client secret. Prefer process env for the secret.
TAILSCALE_AUTHKEY=
# Node name announced to the tailnet.
#TAILSCALE_HOSTNAME=vaultwarden-hummingbird
# Configure `tailscale serve` after a successful up.
#TAILSCALE_SERVE=true
# Advertise as a Tailscale Service svc:<name>; needs a tag-based authkey,
# the Service defined in the admin console (Services page), and approval.
#TAILSCALE_SERVICE=vaultwarden
# false = TUN mode: needs NET_ADMIN + /dev/net/tun.
#TAILSCALE_USERSPACE=true
# LocalAPI unix socket the CLI drives.
#TAILSCALE_SOCKET=/tmp/tailscaled.sock
# tailscaled state file, on the writable data volume.
#TAILSCALE_STATE_FILE=/data/tailscaled.state

# ============================================================================
# VAULTWARDEN_* — vaultwarden core config (REQUIRED)
#   Forwarded to the vaultwarden child under the plain upstream name (the
#   VAULTWARDEN_ prefix is stripped in supervisor mode).
# ============================================================================

# Postgres connection string the vault (and DB backup/keepalive) uses.
VAULTWARDEN_DATABASE_URL=postgresql://user:password@host:5432/vaultwarden
# Externally reachable base URL advertised to clients.
VAULTWARDEN_DOMAIN=https://vaultwarden.example.com

# ============================================================================
# VAULTWARDEN_* — posture hardening (optional; image defaults, file overrides)
# ============================================================================

#VAULTWARDEN_ORG_ATTACHMENT_LIMIT=0
#VAULTWARDEN_ORG_CREATION_USERS=none
#VAULTWARDEN_SENDS_ALLOWED=true
# Flip true to create your account, then back.
#VAULTWARDEN_SIGNUPS_ALLOWED=false
#VAULTWARDEN_USER_ATTACHMENT_LIMIT=0
# Hide the UI without rebuilding; unset = follows WEB_VAULT (build flag).
#VAULTWARDEN_WEB_VAULT_ENABLED=false

# ============================================================================
# VAULTWARDEN_PUSH_* — Bitwarden push relay (optional)
#   Free credentials from https://bitwarden.com/host.
# ============================================================================

#VAULTWARDEN_PUSH_ENABLED=true
#VAULTWARDEN_PUSH_INSTALLATION_ID=
#VAULTWARDEN_PUSH_INSTALLATION_KEY=

# ============================================================================
# VAULTWARDEN_SMTP_* — outbound email (optional)
# ============================================================================

#VAULTWARDEN_SMTP_HOST=smtp.example.com
#VAULTWARDEN_SMTP_FROM=vaultwarden@example.com
#VAULTWARDEN_SMTP_USERNAME=user
#VAULTWARDEN_SMTP_PASSWORD=
# TLS from the first byte; starttls = connect plaintext, upgrade.
#VAULTWARDEN_SMTP_SECURITY=force_tls
#VAULTWARDEN_SMTP_PORT=465
