{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":disableDependencyDashboard",
        "helpers:pinGitHubActionDigests"
    ],
    "abandonmentThreshold": "1 year",
    "addLabels": [
        "renovate",
        "dependencies"
    ],
    "automerge": false,
    "keepUpdatedLabel": "renovate-keep-updated",
    "lockFileMaintenance": {
        "enabled": false
    },
    "osvVulnerabilityAlerts": true,
    "reviewers": [
        "edgarcnp"
    ],
    "rollbackPrs": true,
    "vulnerabilityAlerts": {
        "groupName": null,
        "schedule": [],
        "dependencyDashboardApproval": false,
        "minimumReleaseAge": null,
        "rangeStrategy": "bump",
        "commitMessageSuffix": "[SECURITY]",
        "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
        "prCreation": "immediate",
        "vulnerabilityFixStrategy": "lowest"
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "vaultwarden source pin",
            "fileMatch": [
                "^Containerfile$"
            ],
            "matchStrings": [
                "ARG VW_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "dani-garcia/vaultwarden"
        },
        {
            "customType": "regex",
            "description": "web-vault pin",
            "fileMatch": [
                "^Containerfile$"
            ],
            "matchStrings": [
                "ARG WEB_VAULT_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "dani-garcia/bw_web_builds"
        },
        {
            "customType": "regex",
            "description": "tailscale pin (ARG strips the upstream v prefix)",
            "fileMatch": [
                "^Containerfile$"
            ],
            "matchStrings": [
                "ARG TAILSCALE_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "tailscale/tailscale",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "description": "Hummingbird base image tag pins",
            "fileMatch": [
                "^Containerfile$"
            ],
            "matchStrings": [
                "ARG BUILDER_IMAGE=registry\\.access\\.redhat\\.com/(?<depName>hi/rust):(?<currentValue>\\S+)",
                "ARG RUNTIME_IMAGE=registry\\.access\\.redhat\\.com/(?<depName>hi/core-runtime):(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "docker",
            "registryUrlTemplate": "https://registry.access.redhat.com",
            "pinDigests": false
        }
    ]
}
