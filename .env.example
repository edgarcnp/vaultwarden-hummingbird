# Copy to .env, replace the placeholders (required keys are uncommented
# below), keep out of git. Full guide: docs/configuration.md.
# Values containing '#' must be quoted. Empty values = unset. Unquoted
# $VAR is substituted from the environment; use single quotes to keep a
# literal '$'. Full upstream key list: vaultwarden's .env.template.
#
# EVERY key must belong to one of the three namespaces: SUPERVISOR_*,
# TAILSCALE_*, or VAULTWARDEN_* (reaching the vault under the stripped
# plain name: VAULTWARDEN_DOMAIN -> DOMAIN). The dotenv file is strict:
# anything else — bare upstream names (DATABASE_URL), legacy spellings
# (VAULTWARDEN_ROCKET_PORT, ROCKET_PORT), an unknown SUPERVISOR_*/
# TAILSCALE_* key — refuses to boot, naming the offending keys. Upgrading
# from an older image: prefix every bare key with VAULTWARDEN_ and rename
# the port knob to VAULTWARDEN_PORT.
#
# The container env stays default-deny: only VAULTWARDEN_-prefixed keys
# reach the vault. Use the prefix everywhere and all modes behave
# identically.
#
# The dotenv file itself must live under /state (the supervisor-only
# volume) and outside /state/tailscale and its /state/tailscale-state link
# (the tailscaled-writable subtree): the vault runs as a different uid and
# cannot traverse /state, and tailscaled can replace a file in its own
# subtree. A file mounted anywhere else is refused at boot. Prefer mounting
# it at /state/.env over `podman run --env-file`, which leaves the secrets
# in the container environment (visible to `podman inspect`); the vault
# cannot read PID 1's environment either way. The file must be readable by
# container uid 65532 but not by the tailscale group: use 0600 owned by
# 65532, or 0640 with group 65532. Do not use 0644: the tailscaled group
# can traverse /state and would read it (the supervisor logs a warning
# when it is world-readable).
#
# An unquoted $VAR is substituted from the container environment, not only
# from earlier file keys. Never reference a supervisor secret
# (TAILSCALE_AUTHKEY, SUPERVISOR_S3_*) from a VAULTWARDEN_* value: the
# substitution would copy that secret into the vault's environment.

# SUPERVISOR_* — supervisor plumbing (optional)

# Path to the dotenv file to load. Read from the process env only;
# putting this key in the file itself refuses the boot. Must be under
# /state and outside /state/tailscale; compose mounts it at /state/.env.
# The path must be a regular file: a symlink is refused, so mount the file
# itself (Kubernetes secret projections are symlinks and need a copied
# volume instead).
#SUPERVISOR_ENV_FILE=/state/.env

# Temporary-storage mode (PaaS/ephemeral /data, or TAILSCALE_STATE_FILE=mem:).
# When true, an explicitly configured but unusable S3/backup setting fails
# the boot instead of quietly losing persistence. A tmpfs /data also counts
# as temporary storage. Leave false on a real volume.
#SUPERVISOR_EPHEMERAL=false

# DB backup to S3 (needs the S3 keys below); dumps to <S3_REMOTE>/db.
# Staging and the lineage/unchanged sidecars live under /state, never on
# the vault's /data volume.
#SUPERVISOR_DB_BACKUP=true
#SUPERVISOR_DB_BACKUP_INTERVAL=21600
#SUPERVISOR_DB_BACKUP_KEEP=3
#SUPERVISOR_DB_BACKUP_RESTORE=false
# Manual restore: stop the vault, replace /data/db.sqlite3 with the dump.

# S3 state sync: durable files survive ephemeral redeploys — the tailnet
# identity and cert cache (from /state), the vault's RSA signing key,
# config.json, attachments, and Sends (from /data).
# The bucket must already exist. The key needs object read/write/delete
# and bucket listing (ListObjectsV2) for first-run, restore,
# reconciliation, deletion GC, and backup pruning; create/head are never
# called. SUPERVISOR_S3_ENDPOINT is required — every provider is spelled
# out, AWS included (e.g. https://s3.us-east-1.amazonaws.com).
#SUPERVISOR_S3_REMOTE=r2:vaultwarden
#SUPERVISOR_S3_ACCESS_KEY_ID=
#SUPERVISOR_S3_SECRET_ACCESS_KEY=
#SUPERVISOR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#SUPERVISOR_S3_SYNC_INTERVAL=3600
# Optional S3 transport settings. `path` works with every provider; use
# `virtual` for AWS virtual-hosted bucket URLs. A region is derived from
# AWS endpoints and `auto` otherwise; set it only when a provider needs
# another value. A private CA must be a PEM bundle under /state and outside
# /state/tailscale and its /state/tailscale-state link (the CA
# decides which server is trusted, so the vault must not be able to replace
# it); it replaces the built-in roots, so include the full chain the
# endpoint presents. Plaintext HTTP is refused except for loopback; allow
# it for a trusted private network only.
#SUPERVISOR_S3_URL_STYLE=path
#SUPERVISOR_S3_REGION=us-east-1
#SUPERVISOR_S3_CA_FILE=/state/s3-ca.pem
#SUPERVISOR_S3_ALLOW_HTTP=false

# TAILSCALE_* — required; boot fails closed without it.

# Auth key or OAuth client secret; prefer this dotenv file (mounted under
# /state) over the container environment for the secret.
# Optional when the S3 state sync above can restore the identity, or when a
# valid local TAILSCALE_STATE_FILE already exists. Otherwise required; boot
# fails closed without one of those sources.
TAILSCALE_AUTHKEY=
#TAILSCALE_HOSTNAME=vaultwarden-hummingbird
#TAILSCALE_SERVE=true
# Tag-based authkey + admin-console Service definition + approval.
#TAILSCALE_SERVICE=vaultwarden
# false = TUN mode: needs NET_ADMIN (and NET_RAW for some setups),
# /dev/net/tun, and a runtime that can grant those caps in the container's
# user namespace; rootless podman cannot create a TUN.
#TAILSCALE_USERSPACE=true
# Must live under /state/tailscale (group-writable, 2770): a socket on the
# vault volume could be deleted or impersonated by the vault uid.
#TAILSCALE_SOCKET=/state/tailscale/tailscaled.sock
# The identity must be a direct child of /state/tailscale-state (a
# supervisor-created symlink to the real /state/tailscale tree): Tailscale
# chmods a state parent named exactly "tailscale" to 0700, which the daemon
# uid cannot do on the supervisor-owned group tree (it would silently fall
# back to an in-memory store). A legacy direct child of /state/tailscale is
# mapped onto the link. `mem:` keeps the identity in memory; certs still use
# /state/tailscale/certs.
#TAILSCALE_STATE_FILE=/state/tailscale-state/tailscaled.state

# VAULTWARDEN_* — vaultwarden core config (REQUIRED)

# SQLite on the data volume; other schemes are not built into this image.
#VAULTWARDEN_DATABASE_URL=sqlite:///data/db.sqlite3
# Match the address tailscale serve publishes (MagicDNS + HTTPS certs):
#   node serve: https://<hostname>.<tailnet-name>.ts.net  (TAILSCALE_HOSTNAME)
#   service:    https://<service-name>.<tailnet-name>.ts.net  (TAILSCALE_SERVICE)
VAULTWARDEN_DOMAIN=https://vaultwarden-hummingbird.<tailnet-name>.ts.net
# Gatekeeper port (only /alive; the vault binds loopback one above).
#VAULTWARDEN_PORT=8080

# Any other upstream key works too: prefix it with VAULTWARDEN_ and it
# reaches the vault under the stripped name. Examples (full list:
# vaultwarden's .env.template):

#VAULTWARDEN_INVITATIONS_ALLOWED=false
#VAULTWARDEN_TRASH_AUTO_DELETE_DAYS=30
#VAULTWARDEN_ICON_CACHE_TTL=2592000
#VAULTWARDEN_LOG_LEVEL=info
# Process plumbing for the vault's outbound SMTP/push traffic follows the
# same rule; prefix it so it becomes HTTPS_PROXY/SSL_CERT_FILE in the child:
#VAULTWARDEN_HTTPS_PROXY=http://proxy.example:3128
#VAULTWARDEN_NO_PROXY=.internal,localhost
#VAULTWARDEN_SSL_CERT_FILE=/data/private-ca.pem

# Posture hardening (optional; image defaults).

#VAULTWARDEN_ORG_ATTACHMENT_LIMIT=0
# [VAULTWARDEN_ORG_CREATION_USERS]: none | all | <comma-separated emails>
#VAULTWARDEN_ORG_CREATION_USERS=all
#VAULTWARDEN_SENDS_ALLOWED=true
# Flip true to create your account, then back.
#VAULTWARDEN_SIGNUPS_ALLOWED=true
#VAULTWARDEN_USER_ATTACHMENT_LIMIT=0
#VAULTWARDEN_WEB_VAULT_ENABLED=true
# vaultwarden's volatile-storage gate only flags Docker/Podman's
# 64-character anonymous volume (verified against the 1.37.5 source: a
# manual tmpfs /data boots clean) and it only tests that the variable is
# present. Treat /data as gone unless it's a real volume or S3 sync is on;
# set this to any value only if a future version starts refusing.
# Setting it also enables the supervisor's temporary-storage strictness
# (SUPERVISOR_EPHEMERAL): an unusable S3/backup config then refuses the boot.
#VAULTWARDEN_I_REALLY_WANT_VOLATILE_STORAGE=true

# Bitwarden push relay (optional; free credentials from bitwarden.com/host).

#VAULTWARDEN_PUSH_ENABLED=false
#VAULTWARDEN_PUSH_INSTALLATION_ID=
#VAULTWARDEN_PUSH_INSTALLATION_KEY=

# Outbound email (optional).

#VAULTWARDEN_SMTP_HOST=smtp.example.com
#VAULTWARDEN_SMTP_FROM=vaultwarden@example.com
#VAULTWARDEN_SMTP_USERNAME=user
#VAULTWARDEN_SMTP_PASSWORD=
# [VAULTWARDEN_SMTP_SECURITY]: starttls (587) | force_tls (465) | off (25)
#VAULTWARDEN_SMTP_SECURITY=force_tls
#VAULTWARDEN_SMTP_PORT=465
