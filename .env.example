# Universal config — ONE file, THREE ways to use it:
# 1. Supervisor-owned (self-host, recommended): copy to .env, mount it
#    (-v ./.env:/config/.env:ro -e SUPERVISOR_ENV_FILE=/config/.env) and let
#    the supervisor distribute it: TS_*/SUPERVISOR_* stay with PID 1, the
#    rest reaches the child.
# 2. Container env: --env-file .env (podman/docker) or env_file: .env (compose)
# 3. Render/PaaS: paste the keys into the dashboard (render.yaml prompts).
#
# Precedence:
#   - TS_*/SUPERVISOR_*/PORT/ROCKET_PORT: process env > this file (empty
#     values are treated as unset)
#   - everything else: this file > image-baked defaults — except ROCKET_PORT
#     (follows PORT), ROCKET_ADDRESS (0.0.0.0) and DATA_FOLDER (/data), which
#     the supervisor hard-pins for the child
#
# [vaultwarden] keys are plain upstream env names (full list: vaultwarden's
# .env.template). Values containing '#' must be quoted. Copy to .env, fill
# in, keep it out of git (it holds secrets).

# --- supervisor wiring (set via container env, not this file) ---------------
#SUPERVISOR_ENV_FILE=/config/.env   # compose sets this; here it would be a no-op

# --- supervisor: Tailscale (stays with PID 1) ------------------------------
# auth key or OAuth client secret (OAuth preferred: never expires). Prefer
# the process env (-e TS_AUTHKEY=...) for the secret itself.
#TS_AUTHKEY=
#TS_HOSTNAME=vaultwarden
#TS_SERVE=true
# userspace networking (default) needs no capabilities; TS_USERSPACE=false
# (TUN mode) requires NET_ADMIN + /dev/net/tun and conflicts with the
# compose file's cap_drop: ALL
#TS_USERSPACE=true
#TS_SOCKET=/tmp/tailscaled.sock
#TS_STATE_FILE=/data/tailscaled.state

# --- supervisor: S3 state sync (stays with PID 1; optional) ----------------
# Persists /data identity files (tailscaled.state, rsa_key*) to an
# S3-compatible bucket via baked rclone, so the SAME tailnet node and client
# sessions survive ephemeral redeploys. Requires exactly ONE container per
# bucket/path.
#SUPERVISOR_S3_REMOTE=r2:vw-state
#SUPERVISOR_S3_ACCESS_KEY_ID=
#SUPERVISOR_S3_SECRET_ACCESS_KEY=
#SUPERVISOR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#SUPERVISOR_S3_SYNC_INTERVAL=3600

# --- vaultwarden: required (localized to the child) ------------------------
DATABASE_URL=postgresql://user:password@host:5432/vaultwarden
DOMAIN=https://vaultwarden.example.com

# --- vaultwarden: personal posture (image defaults; file overrides) --------
#SIGNUPS_ALLOWED=false          # flip true to create your account, then back
#ORG_CREATION_USERS=none
#USER_ATTACHMENT_LIMIT=0
#ORG_ATTACHMENT_LIMIT=0
#SENDS_ALLOWED=true
#WEB_VAULT_ENABLED=false        # API-only unless built with WEB_VAULT=true

# --- vaultwarden: optional mobile push (https://bitwarden.com/host) --------
#PUSH_ENABLED=true
#PUSH_INSTALLATION_ID=
#PUSH_INSTALLATION_KEY=

# --- vaultwarden: optional SMTP (invites, 2FA email, verification) ---------
#SMTP_HOST=smtp.example.com
#SMTP_FROM=vaultwarden@example.com
#SMTP_USERNAME=user
#SMTP_PASSWORD=
#SMTP_SECURITY=starttls
#SMTP_PORT=587
