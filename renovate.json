{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":disableDependencyDashboard"
    ],
    "abandonmentThreshold": "1 year",
    "addLabels": [
        "renovate",
        "dependencies"
    ],
    "automerge": false,
    "keepUpdatedLabel": "renovate-keep-updated",
    "lockFileMaintenance": {
        "enabled": false
    },
    "osvVulnerabilityAlerts": true,
    "reviewers": [
        "edgarcnp"
    ],
    "rollbackPrs": true,
    "schedule": [
        "* * * * *"
    ],
    "vulnerabilityAlerts": {
        "groupName": null,
        "schedule": [],
        "dependencyDashboardApproval": false,
        "minimumReleaseAge": null,
        "rangeStrategy": "bump",
        "commitMessageSuffix": "[SECURITY]",
        "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
        "prCreation": "immediate",
        "vulnerabilityFixStrategy": "lowest"
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "vaultwarden source pin",
            "fileMatch": [
                "^Dockerfile$"
            ],
            "matchStrings": [
                "ARG VW_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "dani-garcia/vaultwarden"
        },
        {
            "customType": "regex",
            "description": "web-vault pin",
            "fileMatch": [
                "^Dockerfile$"
            ],
            "matchStrings": [
                "ARG WEB_VAULT_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "dani-garcia/bw_web_builds"
        },
        {
            "customType": "regex",
            "description": "tailscale pin (ARG strips the upstream v prefix)",
            "fileMatch": [
                "^Dockerfile$"
            ],
            "matchStrings": [
                "ARG TAILSCALE_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "tailscale/tailscale",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "description": "Kitware cmake pin (ARG strips the upstream v prefix)",
            "fileMatch": [
                "^Dockerfile$"
            ],
            "matchStrings": [
                "ARG CMAKE_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "Kitware/CMake",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "description": "rclone pin (ARG strips the upstream v prefix)",
            "fileMatch": [
                "^Dockerfile$"
            ],
            "matchStrings": [
                "ARG RCLONE_VERSION=(?<currentValue>\\S+)"
            ],
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "rclone/rclone",
            "extractVersionTemplate": "^v(?<version>.*)$"
        }
    ]
}
