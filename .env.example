# Copy to .env, replace the placeholders (required keys are uncommented
# below), keep out of git. Values containing '#' must be quoted. Empty
# values = unset. Full upstream key list: vaultwarden's .env.template.
#
# EVERY key must belong to one of the three namespaces: SUPERVISOR_*,
# TAILSCALE_*, or VAULTWARDEN_* (reaching the vault under the stripped
# plain name: VAULTWARDEN_DOMAIN -> DOMAIN). The dotenv file is strict:
# anything else — bare upstream names (DATABASE_URL), legacy spellings
# (VAULTWARDEN_ROCKET_PORT, ROCKET_PORT) — refuses to boot, naming the
# offending keys. Upgrading from an older image: prefix every bare key
# with VAULTWARDEN_ and rename the port knob to VAULTWARDEN_PORT.
#
# The container env stays default-deny: only VAULTWARDEN_-prefixed keys
# reach the vault. Use the prefix everywhere and all modes behave
# identically.

# SUPERVISOR_* — supervisor plumbing (optional)

#SUPERVISOR_ENV_FILE=/config/.env

# DB backup to S3 (needs the S3 keys below); dumps to <S3_REMOTE>/db.
#SUPERVISOR_DB_BACKUP=true
#SUPERVISOR_DB_BACKUP_INTERVAL=21600
#SUPERVISOR_DB_BACKUP_KEEP=3
#SUPERVISOR_DB_BACKUP_RESTORE=false
# Manual restore: stop the vault, replace /data/db.sqlite3 with the dump.

# S3 state sync: durable /data files survive ephemeral redeploys — tailnet
# identity, the vault's RSA signing key, TLS certs, attachments, and Sends.
# The bucket must already exist and the key be object-scoped (read/write);
# bucket-level ops (create, head) are never used, so a least-privilege
# R2 token works. SUPERVISOR_S3_ENDPOINT is required — every provider is
# spelled out, AWS included (e.g. https://s3.us-east-1.amazonaws.com).
#SUPERVISOR_S3_REMOTE=r2:vaultwarden
#SUPERVISOR_S3_ACCESS_KEY_ID=
#SUPERVISOR_S3_SECRET_ACCESS_KEY=
#SUPERVISOR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#SUPERVISOR_S3_SYNC_INTERVAL=3600

# TAILSCALE_* — required; boot fails closed without it.

# Auth key or OAuth client secret; prefer process env for the secret.
# Optional when the S3 state sync above is configured: a restored
# tailscaled.state rejoins the tailnet without a key. Otherwise required;
# boot fails closed without one of the two.
TAILSCALE_AUTHKEY=
#TAILSCALE_HOSTNAME=vaultwarden-hummingbird
#TAILSCALE_SERVE=true
# Tag-based authkey + admin-console Service definition + approval.
#TAILSCALE_SERVICE=vaultwarden
# false = TUN mode: needs NET_ADMIN + /dev/net/tun.
#TAILSCALE_USERSPACE=true
#TAILSCALE_SOCKET=/tmp/tailscaled.sock
#TAILSCALE_STATE_FILE=/data/tailscaled.state

# VAULTWARDEN_* — vaultwarden core config (REQUIRED)

# SQLite on the data volume; other schemes are not built into this image.
#VAULTWARDEN_DATABASE_URL=sqlite:///data/db.sqlite3
# Match the address tailscale serve publishes (MagicDNS + HTTPS certs):
#   node serve: https://<hostname>.<tailnet-name>.ts.net  (TAILSCALE_HOSTNAME)
#   service:    https://<service-name>.<tailnet-name>.ts.net  (TAILSCALE_SERVICE)
VAULTWARDEN_DOMAIN=https://vaultwarden-hummingbird.<tailnet-name>.ts.net
# Gatekeeper port (only /alive; the vault binds loopback one above).
#VAULTWARDEN_PORT=8080

# Any other upstream key works too: prefix it with VAULTWARDEN_ and it
# reaches the vault under the stripped name. Examples (full list:
# vaultwarden's .env.template):

#VAULTWARDEN_INVITATIONS_ALLOWED=false
#VAULTWARDEN_TRASH_AUTO_DELETE_DAYS=30
#VAULTWARDEN_ICON_CACHE_TTL=2592000
#VAULTWARDEN_LOG_LEVEL=info

# Posture hardening (optional; image defaults).

#VAULTWARDEN_ORG_ATTACHMENT_LIMIT=0
# [VAULTWARDEN_ORG_CREATION_USERS]: none | all | <comma-separated emails>
#VAULTWARDEN_ORG_CREATION_USERS=all
#VAULTWARDEN_SENDS_ALLOWED=true
# Flip true to create your account, then back.
#VAULTWARDEN_SIGNUPS_ALLOWED=true
#VAULTWARDEN_USER_ATTACHMENT_LIMIT=0
#VAULTWARDEN_WEB_VAULT_ENABLED=true
# vaultwarden refuses to boot on a detected non-persistent /data volume;
# flip true to accept ephemeral vault storage (data loss on redeploys).
#VAULTWARDEN_I_REALLY_WANT_VOLATILE_STORAGE=false

# Bitwarden push relay (optional; free credentials from bitwarden.com/host).

#VAULTWARDEN_PUSH_ENABLED=false
#VAULTWARDEN_PUSH_INSTALLATION_ID=
#VAULTWARDEN_PUSH_INSTALLATION_KEY=

# Outbound email (optional).

#VAULTWARDEN_SMTP_HOST=smtp.example.com
#VAULTWARDEN_SMTP_FROM=vaultwarden@example.com
#VAULTWARDEN_SMTP_USERNAME=user
#VAULTWARDEN_SMTP_PASSWORD=
# [VAULTWARDEN_SMTP_SECURITY]: starttls (587) | force_tls (465) | off (25)
#VAULTWARDEN_SMTP_SECURITY=force_tls
#VAULTWARDEN_SMTP_PORT=465
