# One config file, three ways to use it:
# 1. Supervisor-owned (compose default): copy to .env, mount it, set
#    SUPERVISOR_ENV_FILE. TS_*/SUPERVISOR_* stay with PID 1, the rest is
#    forwarded to vaultwarden.
# 2. Container env: --env-file .env / env_file: .env
# 3. PaaS dashboard
#
# Precedence: process env > file for TS_*/SUPERVISOR_*/PORT/ROCKET_PORT
# (the *exposed* port; only /alive is answered there — the supervisor's
# gatekeeper. vaultwarden itself binds loopback one port above it);
# file > image-baked defaults for the rest (ROCKET_PORT/ROCKET_ADDRESS/
# DATA_FOLDER are hard-pinned by the supervisor). Empty values = unset.
#
# Keys are plain upstream env names (full list: vaultwarden's .env.template).
# Values containing '#' must be quoted. Copy to .env, fill in, keep out of git.

# --- supervisor: Tailscale (PID 1 only) ------------------------------------
#TS_AUTHKEY=            # prefer process env for the secret
#TS_HOSTNAME=vaultwarden
#TS_SERVE=true
#TS_USERSPACE=true      # false = TUN mode: needs NET_ADMIN + /dev/net/tun
#TS_SOCKET=/tmp/tailscaled.sock
#TS_STATE_FILE=/data/tailscaled.state

# --- supervisor: S3 state sync (optional) ----------------------------------
#SUPERVISOR_S3_REMOTE=r2:vw-state
#SUPERVISOR_S3_ACCESS_KEY_ID=
#SUPERVISOR_S3_SECRET_ACCESS_KEY=
#SUPERVISOR_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#SUPERVISOR_S3_SYNC_INTERVAL=3600

# --- supervisor: DB keepalive (optional) -----------------------------------
# Periodic `SELECT 1` so providers that suspend idle databases stay awake.
# Seconds; 0 or unset = off. Requires DATABASE_URL (postgres).
#SUPERVISOR_DB_KEEPALIVE=300

# --- vaultwarden: required -------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/vaultwarden
DOMAIN=https://vaultwarden.example.com

# --- vaultwarden: posture (image defaults; file overrides) -----------------
#SIGNUPS_ALLOWED=false          # flip true to create your account, then back
#ORG_CREATION_USERS=none
#USER_ATTACHMENT_LIMIT=0
#ORG_ATTACHMENT_LIMIT=0
#SENDS_ALLOWED=true
#WEB_VAULT_ENABLED=false       # hide the UI without rebuilding; unset = follows WEB_VAULT

# --- vaultwarden: optional push (https://bitwarden.com/host) ---------------
#PUSH_ENABLED=true
#PUSH_INSTALLATION_ID=
#PUSH_INSTALLATION_KEY=

# --- vaultwarden: optional SMTP --------------------------------------------
#SMTP_HOST=smtp.example.com
#SMTP_FROM=vaultwarden@example.com
#SMTP_USERNAME=user
#SMTP_PASSWORD=
#SMTP_SECURITY=force_tls     # TLS from the first byte; starttls = connect plaintext, upgrade
#SMTP_PORT=465

# --- build-time: compose build args (rebuild required) ----------------------
#WEB_VAULT=true              # false = API-only image (UI files not baked in)
